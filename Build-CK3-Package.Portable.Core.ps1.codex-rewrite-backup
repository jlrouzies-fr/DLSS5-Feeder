[CmdletBinding()]
param(
    [Parameter(Mandatory)] [string]$ReShadeSetup,
    [string]$RenoDxAddon,
    [string]$DlssRuntime,
    [string]$DlssNrRuntime,
    [string]$FeederAddon,
    [string]$FeedLayerZip,
    [string]$LumeniteZip,
    [string]$ReShadeShadersZip,
    [string]$OutputDirectory = (Join-Path $PSScriptRoot 'release\CK3-DLSS-Portable'),
    [switch]$KeepStagingDirectory
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
Add-Type -AssemblyName System.IO.Compression
Add-Type -AssemblyName System.IO.Compression.FileSystem

$official = @{
    FeederAddon = 'https://github.com/jlrouzies-fr/DLSS5-Feeder/releases/latest/download/dlss5-feed.addon64'
    FeedLayerZip = 'https://github.com/jlrouzies-fr/DLSS5-Feeder/releases/latest/download/feed-vk-layer.zip'
    LumeniteZip = 'https://github.com/umar-afzaal/LumeniteFX/archive/refs/heads/mainline.zip'
    ReShadeShadersZip = 'https://github.com/crosire/reshade-shaders/archive/refs/heads/slim.zip'
}

function Write-Step([string]$Message) {
    Write-Host "[build CK3 package] $Message"
}

function Assert-File([string]$Path, [string]$Label, [int64]$MinimumBytes = 1) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw "$Label was not found: '$Path'" }
    $item = Get-Item -LiteralPath $Path
    if ($item.Length -lt $MinimumBytes) { throw "$Label is unexpectedly small ($($item.Length) bytes): '$Path'" }
    return $item.FullName
}

function Get-PeMachine([string]$Path) {
    $stream = [IO.File]::OpenRead($Path)
    $reader = [IO.BinaryReader]::new($stream)
    try {
        if ($stream.Length -lt 4096 -or $reader.ReadUInt16() -ne 0x5A4D) { throw "'$Path' is not a Windows PE file." }
        $stream.Position = 0x3C
        $offset = $reader.ReadInt32()
        if ($offset -lt 0x40 -or ($offset + 6) -gt $stream.Length) { throw "'$Path' has an invalid PE header offset." }
        $stream.Position = $offset
        if ($reader.ReadUInt32() -ne 0x00004550) { throw "'$Path' has an invalid PE signature." }
        return $reader.ReadUInt16()
    }
    finally {
        $reader.Dispose()
        $stream.Dispose()
    }
}

function Assert-PortableExecutable([string]$Path, [string]$Label, [bool]$RequireX64 = $true) {
    $resolved = Assert-File $Path $Label 4096
    $machine = Get-PeMachine $resolved
    if ($RequireX64 -and $machine -ne 0x8664) {
        throw "$Label is not x64 (machine 0x$($machine.ToString('X4'))): '$resolved'"
    }
    return $resolved
}

function Get-OrDownload([string]$Path, [string]$Url, [string]$Destination, [string]$Label) {
    if ($Path) { return Assert-File $Path $Label }
    Write-Step "Downloading $Label from its official repository..."
    Invoke-WebRequest -Uri $Url -OutFile $Destination -UseBasicParsing -Headers @{ 'User-Agent' = 'CK3-DLSS-Package-Builder' }
    return Assert-File $Destination $Label
}

function Expand-ReShadeSetup([string]$SetupPath, [string]$Destination) {
    $setup = Assert-PortableExecutable $SetupPath 'ReShade setup' $false
    if ([IO.Path]::GetFileName($setup) -notmatch '(?i)add[ -_]?on') {
        throw 'The ReShade setup filename does not identify the full add-on build. Download the full add-on build from reshade.me and keep its original filename.'
    }

    $data = [IO.File]::ReadAllBytes($setup)
    $archiveOffset = -1
    for ($offset = 0; $offset -le $data.Length - 4; $offset += 512) {
        if ($data[$offset] -eq 0x50 -and $data[$offset + 1] -eq 0x4B -and
            $data[$offset + 2] -eq 0x03 -and $data[$offset + 3] -eq 0x04) {
            $archiveOffset = $offset
            break
        }
    }
    if ($archiveOffset -lt 0) { throw "Could not locate the embedded ReShade archive in '$setup'." }

    $memory = [IO.MemoryStream]::new()
    try {
        $memory.Write($data, $archiveOffset, $data.Length - $archiveOffset)
        $memory.Position = 0
        $archive = [IO.Compression.ZipArchive]::new($memory, [IO.Compression.ZipArchiveMode]::Read, $true)
        try {
            $entry = $archive.Entries | Where-Object { $_.FullName -eq 'ReShade64.dll' } | Select-Object -First 1
            if (-not $entry) { throw 'The setup archive does not contain ReShade64.dll.' }
            [IO.Compression.ZipFileExtensions]::ExtractToFile($entry, (Join-Path $Destination 'ReShade64.dll'), $true)
        }
        finally { $archive.Dispose() }
    }
    finally { $memory.Dispose() }
}

function Copy-DirectoryContents([string]$Source, [string]$Destination) {
    if (-not (Test-Path -LiteralPath $Source -PathType Container)) { throw "Directory was not found: '$Source'" }
    if (-not (Test-Path -LiteralPath $Destination -PathType Container)) {
        New-Item -ItemType Directory -Path $Destination -Force | Out-Null
    }
    Get-ChildItem -LiteralPath $Source -Force | Copy-Item -Destination $Destination -Recurse -Force
}

function Get-Sha256([string]$Path) {
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
}

function Add-OptionalRuntime(
    [string]$Source,
    [string]$Destination,
    [string]$Label,
    [System.Collections.Generic.List[string]]$Provenance
) {
    if (-not $Source) { return }
    $validated = Assert-PortableExecutable $Source $Label $true
    Copy-Item -LiteralPath $validated -Destination $Destination -Force
    $name = [IO.Path]::GetFileName($Destination)
    $Provenance.Add("Prebundled.$name.Source=$([IO.Path]::GetFileName($validated))")
    $Provenance.Add("Prebundled.$name.Sha256=$(Get-Sha256 $Destination)")
}

$template = Join-Path $PSScriptRoot 'ck3-package'
if (-not (Test-Path -LiteralPath $template -PathType Container)) { throw "CK3 package template not found: '$template'" }
$reshade = Assert-PortableExecutable $ReShadeSetup 'ReShade setup' $false

$output = [IO.Path]::GetFullPath($OutputDirectory)
$releaseRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot 'release'))
if (-not $output.StartsWith($releaseRoot + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
    throw "OutputDirectory must remain below '$releaseRoot'."
}

$temp = Join-Path ([IO.Path]::GetTempPath()) ('ck3-dlss-build-' + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $temp -Force | Out-Null
try {
    $downloads = Join-Path $temp 'downloads'
    $extract = Join-Path $temp 'extract'
    New-Item -ItemType Directory -Path $downloads, $extract -Force | Out-Null

    $feeder = Get-OrDownload $FeederAddon $official.FeederAddon (Join-Path $downloads 'dlss5-feed.addon64') 'DLSS feeder add-on'
    $layerArchive = Get-OrDownload $FeedLayerZip $official.FeedLayerZip (Join-Path $downloads 'feed-vk-layer.zip') 'DLSS feeder Vulkan layer'
    $lumeniteArchive = Get-OrDownload $LumeniteZip $official.LumeniteZip (Join-Path $downloads 'LumeniteFX-mainline.zip') 'LumeniteFX'
    $shaderArchive = Get-OrDownload $ReShadeShadersZip $official.ReShadeShadersZip (Join-Path $downloads 'reshade-shaders.zip') 'ReShade standard shaders'
    Assert-PortableExecutable $feeder 'DLSS feeder add-on' $true | Out-Null

    if (Test-Path -LiteralPath $output -PathType Container) {
        Write-Step "Replacing old staging directory '$output'."
        Remove-Item -LiteralPath $output -Recurse -Force
    }
    New-Item -ItemType Directory -Path $output -Force | Out-Null
    Copy-DirectoryContents $template $output

    $binaryRoot = Join-Path $output 'binaries'
    $payloadRoot = Join-Path $binaryRoot 'dlss-payload'
    $runtimeRoot = Join-Path $payloadRoot 'runtimes'
    $layerRoot = Join-Path $binaryRoot 'dlss5-vulkan'
    $shaderRoot = Join-Path $binaryRoot 'reshade-shaders\Shaders'
    $textureRoot = Join-Path $binaryRoot 'reshade-shaders\Textures'
    New-Item -ItemType Directory -Path $payloadRoot, $runtimeRoot, $layerRoot, $shaderRoot, $textureRoot -Force | Out-Null

    Copy-Item -LiteralPath $feeder -Destination (Join-Path $payloadRoot 'dlss5-feed.addon64') -Force
    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'shaders\DLSS5_Feed.fx') -Destination $shaderRoot -Force

    $provenance = [System.Collections.Generic.List[string]]::new()
    $provenance.Add('CK3 DLSS portable package build provenance')
    $provenance.Add("BuiltUtc=$([DateTime]::UtcNow.ToString('o'))")
    $provenance.Add("FeederUrl=$($official.FeederAddon)")
    $provenance.Add("FeederSha256=$(Get-Sha256 (Join-Path $payloadRoot 'dlss5-feed.addon64'))")
    $provenance.Add("FeedLayerUrl=$($official.FeedLayerZip)")
    $provenance.Add("LumeniteUrl=$($official.LumeniteZip)")
    $provenance.Add("ReShadeShadersUrl=$($official.ReShadeShadersZip)")

    Add-OptionalRuntime $DlssRuntime (Join-Path $runtimeRoot 'nvngx_dlss.dll') 'NVIDIA DLSS runtime' $provenance
    Add-OptionalRuntime $DlssNrRuntime (Join-Path $runtimeRoot 'nvngx_dlssnr.dll') 'NVIDIA DLSS Neural Rendering runtime' $provenance
    Add-OptionalRuntime $RenoDxAddon (Join-Path $runtimeRoot 'renodx-dlss5.addon64') 'RenoDX DLSS 5 add-on' $provenance
    if (-not $DlssRuntime) { $provenance.Add('Prebundled.nvngx_dlss.dll=No; acquired on demand after user consent') }
    if (-not $DlssNrRuntime) { $provenance.Add('Prebundled.nvngx_dlssnr.dll=No; acquired on demand for Neural Rendering profiles') }
    if (-not $RenoDxAddon) { $provenance.Add('Prebundled.renodx-dlss5.addon64=No; acquired on demand for Neural Rendering profiles') }

    Write-Step 'Extracting the ReShade full add-on build...'
    Expand-ReShadeSetup $reshade $layerRoot
    $provenance.Add("ReShadeSource=$([IO.Path]::GetFileName($reshade))")
    $provenance.Add("ReShade64Sha256=$(Get-Sha256 (Join-Path $layerRoot 'ReShade64.dll'))")

    $layerExtract = Join-Path $extract 'layer'
    Expand-Archive -LiteralPath $layerArchive -DestinationPath $layerExtract -Force
    foreach ($name in @('VkLayer_feed_vk.dll', 'VkLayer_feed_vk.json')) {
        $matches = @(Get-ChildItem -LiteralPath $layerExtract -Recurse -File -Filter $name)
        if ($matches.Count -ne 1) { throw "Expected one $name in the feeder Vulkan layer archive; found $($matches.Count)." }
        Copy-Item -LiteralPath $matches[0].FullName -Destination $layerRoot -Force
    }

    $lumeniteExtract = Join-Path $extract 'lumenite'
    Expand-Archive -LiteralPath $lumeniteArchive -DestinationPath $lumeniteExtract -Force
    $lumeniteRoot = Get-ChildItem -LiteralPath $lumeniteExtract -Directory | Select-Object -First 1
    if (-not $lumeniteRoot) { throw 'LumeniteFX archive has no root directory.' }
    Copy-DirectoryContents (Join-Path $lumeniteRoot.FullName 'Shaders') $shaderRoot
    Copy-DirectoryContents (Join-Path $lumeniteRoot.FullName 'Textures') $textureRoot

    $reshadeExtract = Join-Path $extract 'reshade-shaders'
    Expand-Archive -LiteralPath $shaderArchive -DestinationPath $reshadeExtract -Force
    $reshadeRoot = Get-ChildItem -LiteralPath $reshadeExtract -Directory | Select-Object -First 1
    if (-not $reshadeRoot -or -not (Test-Path -LiteralPath (Join-Path $reshadeRoot.FullName 'Shaders\ReShade.fxh'))) {
        throw 'The ReShade shader archive does not contain Shaders\ReShade.fxh.'
    }
    foreach ($folder in @('Shaders', 'Textures')) {
        $source = Join-Path $reshadeRoot.FullName $folder
        if (Test-Path -LiteralPath $source -PathType Container) {
            $destination = Join-Path (Join-Path $binaryRoot 'reshade-shaders') $folder
            Copy-DirectoryContents $source $destination
        }
    }

    Remove-Item -LiteralPath (Join-Path $layerRoot 'README-PAYLOAD.txt') -Force -ErrorAction SilentlyContinue
    [IO.File]::WriteAllLines((Join-Path $output 'BUILD-PROVENANCE.txt'), $provenance, [Text.UTF8Encoding]::new($false))

    $zipPath = "$output.zip"
    if (Test-Path -LiteralPath $zipPath -PathType Leaf) { Remove-Item -LiteralPath $zipPath -Force }
    Compress-Archive -Path (Join-Path $output '*') -DestinationPath $zipPath -CompressionLevel Optimal
    Write-Step "Created '$zipPath'."
    if ($DlssRuntime -or $DlssNrRuntime -or $RenoDxAddon) {
        Write-Warning 'The ZIP contains supplied proprietary/community runtime files. Confirm redistribution permission before publishing it.'
    }
    else {
        Write-Step 'Created a thin package: NVIDIA/RenoDX files are downloaded only after the end user opts in.'
    }

    if (-not $KeepStagingDirectory) {
        Remove-Item -LiteralPath $output -Recurse -Force
        Write-Step 'Removed the unpacked staging directory (use -KeepStagingDirectory to retain it).'
    }
}
finally {
    if (Test-Path -LiteralPath $temp) { Remove-Item -LiteralPath $temp -Recurse -Force }
}

