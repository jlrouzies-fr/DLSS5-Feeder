diff --git a/ck3-package/DLSS-Runtime-Setup.ps1 b/ck3-package/DLSS-Runtime-Setup.ps1
--- a/ck3-package/DLSS-Runtime-Setup.ps1
+++ b/ck3-package/DLSS-Runtime-Setup.ps1
@@ -468,3 +468,3 @@
-    # K is NVIDIA's recommended DLAA default. L/M are explicit 4.5 comparison models;
-    # RTX 20/30 cards lack native FP8 and can pay a much larger cost for them.
-    $preset = if ($SelectedMode -eq 'DLSS45') { 11 } else { 0 }
+    # Model M explicitly enables the requested DLSS 4.5 test. It works with DLAA on RTX 3060,
+    # although RTX 20/30 cards lack native FP8 and can pay a larger performance cost than K.
+    $preset = if ($SelectedMode -eq 'DLSS45') { 13 } else { 0 }
