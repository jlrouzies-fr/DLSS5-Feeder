[CmdletBinding()]
param()

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$repoRoot = Split-Path -Parent $PSScriptRoot
$releaseRoot = [IO.Path]::GetFullPath((Join-Path $repoRoot 'release'))
$testId = [guid]::NewGuid().ToString('N')
$tempRoot = Join-Path ([IO.Path]::GetTempPath()) ("ck3-builder-tests-$testId")
$thinOutput = Join-Path $releaseRoot "test-thin-$testId"
$fatOutput = Join-Path $releaseRoot "test-offline-$testId"

function Assert-True([bool]$Condition, [string]$Message) {
    if (-not $Condition) { throw "ASSERTION FAILED: $Message" }
}

function Ensure-Directory([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path)) { New-Item -ItemType Directory -Path $Path -Force | Out-Null }
}

function New-FakeX64Pe([string]$Path) {
    Ensure-Directory (Split-Path -Parent $Path)
    $bytes = [byte[]]::new(8192)
    $bytes[0] = 0x4D
    $bytes[1] = 0x5A
    [BitConverter]::GetBytes([int]0x80).CopyTo($bytes, 0x3C)
    $bytes[0x80] = 0x50
    $bytes[0x81] = 0x45
    [BitConverter]::GetBytes([uint16]0x8664).CopyTo($bytes, 0x84)
    [IO.File]::WriteAllBytes($Path, $bytes)
}

function Write-Utf8([string]$Path, [string]$Text) {
    Ensure-Directory (Split-Path -Parent $Path)
    [IO.File]::WriteAllText($Path, $Text, [Text.UTF8Encoding]::new($false))
}

function New-ZipFromDirectory([string]$Source, [string]$Destination) {
    if (Test-Path -LiteralPath $Destination) { Remove-Item -LiteralPath $Destination -Force }
    Compress-Archive -Path (Join-Path $Source '*') -DestinationPath $Destination -CompressionLevel Optimal
}

function Assert-SafeTestOutput([string]$Path) {
    $resolved = [IO.Path]::GetFullPath($Path)
    if (-not $resolved.StartsWith($releaseRoot + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase) -or
        (Split-Path -Leaf $resolved) -notmatch "^test-(thin|offline)-$testId$") {
        throw "Refusing to remove unexpected test output '$resolved'."
    }
}

try {
    Ensure-Directory $tempRoot
    $inputs = Join-Path $tempRoot 'inputs'
    Ensure-Directory $inputs

    $feeder = Join-Path $inputs 'dlss5-feed.addon64'
    $dlss = Join-Path $inputs 'nvngx_dlss.dll'
    $dlssNr = Join-Path $inputs 'nvngx_dlssnr.dll'
    $reno = Join-Path $inputs 'renodx-dlss5.addon64'
    New-FakeX64Pe $feeder
    New-FakeX64Pe $dlss
    New-FakeX64Pe $dlssNr
    New-FakeX64Pe $reno

    $reshadePayload = Join-Path $tempRoot 'reshade-payload'
    Ensure-Directory $reshadePayload
    New-FakeX64Pe (Join-Path $reshadePayload 'ReShade64.dll')
    $embeddedZip = Join-Path $tempRoot 'reshade-embedded.zip'
    New-ZipFromDirectory $reshadePayload $embeddedZip
    $prefix = [byte[]]::new(8192)
    $prefix[0] = 0x4D
    $prefix[1] = 0x5A
    [BitConverter]::GetBytes([int]0x80).CopyTo($prefix, 0x3C)
    $prefix[0x80] = 0x50
    $prefix[0x81] = 0x45
    [BitConverter]::GetBytes([uint16]0x014C).CopyTo($prefix, 0x84)
    $zipBytes = [IO.File]::ReadAllBytes($embeddedZip)
    $setupBytes = [byte[]]::new($prefix.Length + $zipBytes.Length)
    $prefix.CopyTo($setupBytes, 0)
    $zipBytes.CopyTo($setupBytes, $prefix.Length)
    $reshadeSetup = Join-Path $inputs 'ReShade_Setup_Addon.exe'
    [IO.File]::WriteAllBytes($reshadeSetup, $setupBytes)

    $layerSource = Join-Path $tempRoot 'layer-source'
    New-FakeX64Pe (Join-Path $layerSource 'VkLayer_feed_vk.dll')
    Write-Utf8 (Join-Path $layerSource 'VkLayer_feed_vk.json') '{"layer":{"name":"VK_LAYER_feed_vk"}}'
    $layerZip = Join-Path $inputs 'feed-vk-layer.zip'
    New-ZipFromDirectory $layerSource $layerZip

    $lumeniteSource = Join-Path $tempRoot 'lumenite-source\LumeniteFX-mainline'
    Write-Utf8 (Join-Path $lumeniteSource 'Shaders\lumenite_Kernel.fx') '// fake Lumenite'
    Write-Utf8 (Join-Path $lumeniteSource 'Textures\lumenite_bluenoise256.png') 'fake png'
    $lumeniteZip = Join-Path $inputs 'LumeniteFX-mainline.zip'
    New-ZipFromDirectory (Split-Path -Parent $lumeniteSource) $lumeniteZip

    $shaderSource = Join-Path $tempRoot 'shader-source\reshade-shaders-slim'
    Write-Utf8 (Join-Path $shaderSource 'Shaders\ReShade.fxh') '// fake ReShade header'
    Write-Utf8 (Join-Path $shaderSource 'Textures\README.txt') 'fake texture payload'
    $shaderZip = Join-Path $inputs 'reshade-shaders.zip'
    New-ZipFromDirectory (Split-Path -Parent $shaderSource) $shaderZip

    $common = @{
        ReShadeSetup = $reshadeSetup
        FeederAddon = $feeder
        FeedLayerZip = $layerZip
        LumeniteZip = $lumeniteZip
        ReShadeShadersZip = $shaderZip
        KeepStagingDirectory = $true
    }

    Write-Host 'TEST: thin package builds without proprietary/community runtimes'
    $thinArguments = $common.Clone()
    $thinArguments.OutputDirectory = $thinOutput
    & (Join-Path $repoRoot 'Build-CK3-Package.ps1') @thinArguments
    Assert-True (Test-Path -LiteralPath "$thinOutput.zip" -PathType Leaf) 'Thin release ZIP was not created.'
    Assert-True (Test-Path -LiteralPath (Join-Path $thinOutput 'binaries\dlss-payload\dlss5-feed.addon64') -PathType Leaf) 'Feeder payload is missing.'
    Assert-True (-not (Test-Path -LiteralPath (Join-Path $thinOutput 'binaries\dlss-payload\runtimes\nvngx_dlss.dll') -PathType Leaf)) 'Thin build unexpectedly contains DLSS.'
    Assert-True (-not (Test-Path -LiteralPath (Join-Path $thinOutput 'binaries\dlss-payload\runtimes\nvngx_dlssnr.dll') -PathType Leaf)) 'Thin build unexpectedly contains DLSS NR.'
    Assert-True (-not (Test-Path -LiteralPath (Join-Path $thinOutput 'binaries\dlss-payload\runtimes\renodx-dlss5.addon64') -PathType Leaf)) 'Thin build unexpectedly contains RenoDX.'
    Assert-True (Test-Path -LiteralPath (Join-Path $thinOutput 'Install CK3 DLSS.cmd') -PathType Leaf) 'One-click installer is missing.'
    Assert-True ((Get-Content -LiteralPath (Join-Path $thinOutput 'BUILD-PROVENANCE.txt') -Raw) -match 'acquired on demand after user consent') 'Thin provenance does not record on-demand acquisition.'

    Write-Host 'TEST: optional offline inputs are staged but remain profile-controlled'
    $fatArguments = $common.Clone()
    $fatArguments.OutputDirectory = $fatOutput
    $fatArguments.DlssRuntime = $dlss
    $fatArguments.DlssNrRuntime = $dlssNr
    $fatArguments.RenoDxAddon = $reno
    & (Join-Path $repoRoot 'Build-CK3-Package.ps1') @fatArguments
    foreach ($name in @('nvngx_dlss.dll', 'nvngx_dlssnr.dll', 'renodx-dlss5.addon64')) {
        Assert-True (Test-Path -LiteralPath (Join-Path $fatOutput "binaries\dlss-payload\runtimes\$name") -PathType Leaf) "Offline payload is missing $name."
        Assert-True (-not (Test-Path -LiteralPath (Join-Path $fatOutput "binaries\dlss-active\$name") -PathType Leaf)) "$name was activated at build time."
    }

    Write-Host 'All isolated CK3 builder tests passed.' -ForegroundColor Green
}
finally {
    foreach ($output in @($thinOutput, $fatOutput)) {
        Assert-SafeTestOutput $output
        if (Test-Path -LiteralPath $output) { Remove-Item -LiteralPath $output -Recurse -Force }
        if (Test-Path -LiteralPath "$output.zip") { Remove-Item -LiteralPath "$output.zip" -Force }
    }
    if (Test-Path -LiteralPath $tempRoot) { Remove-Item -LiteralPath $tempRoot -Recurse -Force }
}

