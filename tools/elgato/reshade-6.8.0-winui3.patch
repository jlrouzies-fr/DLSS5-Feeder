+
+// DLSS5-Feeder local patch (2026-09-08): the two WinRT Direct3D 11 interop exports of d3d11.dll
+// (windows.graphics.directx.direct3d11.interop.h). WinUI 3, Win2D and Media Foundation import them,
+// so a ReShade installed as d3d11.dll for such an app fails with "Entry Point Not Found" without
+// them (seen in Elgato Studio: Elgato.MFComponents.dll, Microsoft.Graphics.Canvas.dll, Windows.Media.dll).
+// Both are pass-throughs to the real d3d11.dll. The device variant hands over the original DXGI
+// device rather than ReShade's proxy, for the same reason the D2D1 hooks do.
+#include <inspectable.h>
+#include "dxgi/dxgi_device.hpp"
+
+static FARPROC d3d11_winrt_interop_from_system(const char *name)
+{
+	WCHAR path[MAX_PATH];
+	if (GetSystemDirectoryW(path, MAX_PATH) == 0 || wcscat_s(path, L"\\d3d11.dll") != 0)
+		return nullptr;
+	const HMODULE module = LoadLibraryW(path);
+	return module != nullptr ? GetProcAddress(module, name) : nullptr;
+}
+
+extern "C" HRESULT WINAPI CreateDirect3D11DeviceFromDXGIDevice(IDXGIDevice *dxgiDevice, IInspectable **graphicsDevice)
+{
+	reshade::log::message(
+		reshade::log::level::info,
+		"Redirecting CreateDirect3D11DeviceFromDXGIDevice(dxgiDevice = %p, graphicsDevice = %p) ...",
+		dxgiDevice, graphicsDevice);
+
+	if (com_ptr<DXGIDevice> device_proxy;
+		dxgiDevice != nullptr && SUCCEEDED(dxgiDevice->QueryInterface(&device_proxy)))
+		dxgiDevice = device_proxy->_orig;
+
+	auto trampoline = reshade::hooks::call(CreateDirect3D11DeviceFromDXGIDevice);
+	if (trampoline == nullptr)
+		trampoline = reinterpret_cast<decltype(trampoline)>(d3d11_winrt_interop_from_system("CreateDirect3D11DeviceFromDXGIDevice"));
+	if (trampoline == nullptr)
+		return E_NOTIMPL;
+
+	const HRESULT hr = trampoline(dxgiDevice, graphicsDevice);
+	if (FAILED(hr))
+		reshade::log::message(reshade::log::level::warning, "CreateDirect3D11DeviceFromDXGIDevice failed with error code %s.", reshade::log::hr_to_string(hr).c_str());
+	return hr;
+}
+
+extern "C" HRESULT WINAPI CreateDirect3D11SurfaceFromDXGISurface(IDXGISurface *dxgiSurface, IInspectable **graphicsSurface)
+{
+	auto trampoline = reshade::hooks::call(CreateDirect3D11SurfaceFromDXGISurface);
+	if (trampoline == nullptr)
+		trampoline = reinterpret_cast<decltype(trampoline)>(d3d11_winrt_interop_from_system("CreateDirect3D11SurfaceFromDXGISurface"));
+	if (trampoline == nullptr)
+		return E_NOTIMPL;
+
+	const HRESULT hr = trampoline(dxgiSurface, graphicsSurface);
+	if (FAILED(hr))
+		reshade::log::message(reshade::log::level::warning, "CreateDirect3D11SurfaceFromDXGISurface failed with error code %s.", reshade::log::hr_to_string(hr).c_str());
+	return hr;
+}
