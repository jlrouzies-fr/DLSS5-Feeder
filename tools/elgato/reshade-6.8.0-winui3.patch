+// DLSS5-Feeder local patch (2026-09-08): a composition swap chain (WinUI 3 SwapChainPanel, CoreWindow
+// interop) has no output window, which left the runtime without input and therefore without any way
+// to open the overlay. Fall back to the process's main top-level window in that case.
+#include <Windows.h>
+static HWND find_process_main_window()
+{
+	struct search { DWORD pid; HWND found; } s = { GetCurrentProcessId(), nullptr };
+	EnumWindows([](HWND hwnd, LPARAM lparam) -> BOOL {
+		search *const s = reinterpret_cast<search *>(lparam);
+		DWORD pid = 0;
+		GetWindowThreadProcessId(hwnd, &pid);
+		if (pid != s->pid || !IsWindowVisible(hwnd) || GetWindow(hwnd, GW_OWNER) != nullptr)
+			return TRUE;
+		s->found = hwnd;
+		return FALSE;
+	}, reinterpret_cast<LPARAM>(&s));
+	return s.found;
+}
