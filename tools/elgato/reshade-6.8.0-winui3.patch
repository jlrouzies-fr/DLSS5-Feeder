+// DLSS5-Feeder local patch (2026-09-08): WinUI 3's lifted composition engine (dwmcorei.dll, with
+// dcompi.dll) hands the D3D11 device it creates to Direct2D through a path the D2D1 hooks do not
+// cover, and D2D refuses a proxied device: the process fail-fasts inside dwmcorei.dll with
+// D2DERR_UNSUPPORTED_OPERATION (0x88990003) right after its D2D1CreateFactory call. Devices those
+// modules create are therefore passed through unproxied; the application's own devices still are.
+const wchar_t *caller_module_name(void *return_address, wchar_t (&module_path)[MAX_PATH])
+{
+	HMODULE module = nullptr;
+	if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, static_cast<LPCWSTR>(return_address), &module) ||
+		GetModuleFileNameW(module, module_path, MAX_PATH) == 0)
+		return L"<unknown>";
+	const wchar_t *name = wcsrchr(module_path, L'\\');
+	return name != nullptr ? name + 1 : module_path;
+}
+extern HMODULE g_module_handle;
+// The immediate return address is not enough: an interposer such as OptiScaler (loaded as winmm.dll or
+// version.dll) hooks D3D11CreateDevice too and sits between the real requester and this module. Walk
+// the stack and take the first frame that belongs to neither ReShade, the D3D/DXGI runtime, nor a proxy.
+static const wchar_t *requesting_module_name(wchar_t (&module_path)[MAX_PATH])
+{
+	void *frames[24];
+	const USHORT count = RtlCaptureStackBackTrace(1, ARRAYSIZE(frames), frames, nullptr);
+	for (USHORT i = 0; i < count; ++i)
+	{
+		HMODULE module = nullptr;
+		if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, static_cast<LPCWSTR>(frames[i]), &module) ||
+			module == g_module_handle || GetModuleFileNameW(module, module_path, MAX_PATH) == 0)
+			continue;
+		const wchar_t *name = wcsrchr(module_path, L'\\');
+		name = name != nullptr ? name + 1 : module_path;
+		if (_wcsicmp(name, L"dxgi.dll") == 0 || _wcsicmp(name, L"d3d11.dll") == 0 || _wcsicmp(name, L"d3d10warp.dll") == 0 ||
+			_wcsicmp(name, L"winmm.dll") == 0 || _wcsicmp(name, L"version.dll") == 0)
+			continue;
+		return name;
+	}
+	return L"<unknown>";
+}
+static bool is_composition_engine_caller(void *, wchar_t (&module_path)[MAX_PATH])
+{
+	const wchar_t *const name = requesting_module_name(module_path);
+	reshade::log::message(reshade::log::level::info, "> D3D11 device creation requested by %ls", name);
+	return _wcsicmp(name, L"dwmcorei.dll") == 0 || _wcsicmp(name, L"dcompi.dll") == 0;
+}
