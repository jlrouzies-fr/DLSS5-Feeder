[CmdletBinding()]
param(
    [Parameter(Mandatory)] [string]$ReShadeSetup,
    [string]$RenoDxAddon,
    [string]$DlssRuntime,
    [string]$DlssNrRuntime,
    [string]$FeederAddon,
    [string]$FeedLayerZip,
    [string]$LumeniteZip,
    [string]$ReShadeShadersZip,
    [string]$OutputDirectory = (Join-Path $PSScriptRoot 'release\CK3-DLSS-Portable'),
    [switch]$KeepStagingDirectory
)

$ErrorActionPreference = 'Stop'
$core = Join-Path $PSScriptRoot 'Build-CK3-Package.Portable.Core.ps1'
$arguments = @{
    ReShadeSetup = $ReShadeSetup
    OutputDirectory = $OutputDirectory
    KeepStagingDirectory = $KeepStagingDirectory
}

foreach ($name in @('RenoDxAddon', 'DlssRuntime', 'DlssNrRuntime', 'FeederAddon', 'FeedLayerZip', 'LumeniteZip', 'ReShadeShadersZip')) {
    $value = Get-Variable -Name $name -ValueOnly
    if ($value) { $arguments[$name] = $value }
}

& $core @arguments

