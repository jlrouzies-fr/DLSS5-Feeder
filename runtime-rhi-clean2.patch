diff --git a/ck3-package/DLSS-Runtime-Setup.ps1 b/ck3-package/DLSS-Runtime-Setup.ps1
--- a/ck3-package/DLSS-Runtime-Setup.ps1
+++ b/ck3-package/DLSS-Runtime-Setup.ps1
@@ -191,6 +191,6 @@ function Select-RuntimeMode([string[]]$GpuNames) {
     Write-Host ''
     Write-Host '  1. DLSS 4.5 / DLAA compatibility  (recommended for RTX 20/30/40, including RTX 3060)'
-    Write-Host '  2. DLSS 5 Neural Rendering       (official supported-hardware runtime)'
+    Write-Host '  2. DLSS 5 Neural Rendering       (NVIDIA-signed preview runtime selected through RHI)'
     Write-Host '  3. DLSS 5 Extended               (experimental RHI/ShortFuse runtime for RTX 20/30/40)'
